{
  "a": {
    "name": "Author A",
    "url": "https://example-a.invalid/",
    "profileDir": ".browser-profiles/a",
    "headless": false,
    "timeoutMs": 120000,
    "session": {
      "newConversationSelector": "[data-action='new-chat']",
      "readySelector": "textarea"
    },
    "completion": {
      "doneSelector": "[data-state='done']",
      "requireSingleAssistantNode": true,
      "allowStabilityFallback": false
    },
    "selectors": {
      "input": "textarea",
      "send": "button[type='submit']",
      "assistantMessage": "[data-role='assistant']"
    }
  },
  "b": {
    "name": "Reviewer B",
    "url": "https://example-b.invalid/",
    "profileDir": ".browser-profiles/b",
    "headless": false,
    "timeoutMs": 120000,
    "session": {
      "newConversationSelector": "[data-action='new-chat']",
      "readySelector": "textarea"
    },
    "completion": {
      "generatingSelector": "[data-state='generating']",
      "requireSingleAssistantNode": true,
      "allowMissingGenerationStart": false,
      "allowStabilityFallback": false
    },
    "selectors": {
      "input": "textarea",
      "send": "button[type='submit']",
      "assistantMessage": "[data-role='assistant'][data-final='true']"
    }
  }
}
